{
	"name": "n8n-nodes-lmaoapi",
	"version": "1.0.0",
	"description": "便捷调用 LmaoAPI 进行文字生成、图像生成与音频转文本",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package",
		"n8n-nodes-lmaoapi",
		"lmaoapi",
		"lmao",
		"文字生成",
		"图像生成",
		"音频转文本",
		"nano banana"
	],
	"author": {
		"name": "毛淞淮",
		"email": "263674673@qq.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kkuxb/n8n-nodes-lmaoapi.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
