{
	"hooks": {
		"before:init": [
			"npm run lint",
			"npm run build"
		]
	},
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"requireUpstream": true,
		"requireCommits": true,
		"commit": true,
		"commitMessage": "chore: release version ${version}",
		"tag": true,
		"tagName": "v${version}",
		"push": true,
		"changelog": "node scripts/release-notes.mjs"
	},
	"npm": {
		"publish": false
	},
	"github": {
		"release": true,
		"releaseName": "v${version}",
		"releaseNotes": "node scripts/release-notes.mjs ${version}"
	}
}
